# ============================================
# Optivix Backend Environment Variables
# ============================================

# Server Configuration
PORT=5000

# Security
JWT_SECRET=your_super_secret_jwt_key_change_this_to_random_string

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/optivix?retryWrites=true&w=majority

# AI — Ollama (local LLM, optional). Install: https://ollama.com then `ollama pull codellama`
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=codellama
OLLAMA_TIMEOUT_MS=90000
# auto | ollama | heuristic
AI_PROVIDER=auto

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Production (Uncomment when deploying)
# FRONTEND_URL=https://your-vercel-app.vercel.app

# ─── Email OTP (register) — pick ONE option ─────────────────
# Option A: Resend (easiest) — https://resend.com
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Optivix <onboarding@yourdomain.com>

# Option B: Gmail SMTP — use App Password (not normal password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM=Optivix <your@gmail.com>
