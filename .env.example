# ============================================
# Optivix Backend Environment Variables
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Update values below with your actual data
# 3. Never commit .env file to Git
#
# ============================================

# Server Configuration
PORT=5000

# Security
JWT_SECRET=your_super_secret_jwt_key_change_this_to_random_string

# Database (MongoDB Atlas)
# Get this from: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/optivix?retryWrites=true&w=majority

# Frontend URL (for CORS)
# Local Development:
FRONTEND_URL=http://localhost:3000

# Production (Render) - Uncomment when deploying:
# FRONTEND_URL=https://your-vercel-app.vercel.app
